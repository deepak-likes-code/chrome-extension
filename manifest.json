{
  "manifest_version": 3,
  "name": "FocusTab",
  "version": "1.1.0",
  "description": "A calmer browser for focused work, recoverable workspaces, and fast search.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "tabs",
    "tabGroups",
    "sessions",
    "alarms",
    "sidePanel",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_permissions": [
    "bookmarks",
    "history",
    "browsingData"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open FocusTab side panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open FocusTab side panel"
    }
  }
}
