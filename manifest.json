{
  "manifest_version": 3,

  "name": "Floez – Productive New Tab",
  "description": "Minimal new-tab dashboard with to-dos, site blocking, Pomodoro timer and browsing analytics.",
  "version": "1.1.0",

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "chrome_url_overrides": {
    "newtab": "index.html"
  },

  "action": {
    "default_title": "FocusWave",
    "default_popup": "index.html"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://duckduckgo.com/*",
        "https://www.bing.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],

  "permissions": [
    "storage",
    "bookmarks",
    "contextMenus",
    "tabs",
    "idle",
    "notifications",
    "webNavigation",
    "alarms",
    "tts"
  ],

  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.twitter.com/*"
  ],

  "minimum_chrome_version": "114"
}
